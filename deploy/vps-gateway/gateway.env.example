# Copy to gateway.env and fill in. gateway.env is gitignored — never commit secrets.

# Shared frp auth token. Must match auth.token used by every frpc client
# (personal-gateway on pz-win, and mouding's native frpc).
# Generate with: openssl rand -hex 32
FRP_TOKEN=change-me-openssl-rand-hex-32

# frp control port (frpc connects here). Open in the cloud security group.
FRP_BIND_PORT=7000

# Public port for the personal gateway (nginx on pz-win). Open in the
# security group. All personal MCPs are reached under
#   http://<vps>:<PUBLIC_PORT>/<service>/...
PUBLIC_PORT=300

# frps dashboard (bound to 127.0.0.1 only — reach it over an SSH tunnel).
DASHBOARD_USER=admin
# Generate with: openssl rand -base64 24
DASHBOARD_PASSWORD=change-me

# frp version to install.
FRP_VERSION=0.61.2
